+    def _uses_modern_segmented_script(self, package: Optional[dict] = None) -> bool:
+        """Return True for packages whose blocks are intentional story segments.
+
+        Chapter-budget/map-reduce output can legitimately contain more than the
+        old beat cap. That cap only rejects legacy scene-per-block caches.
+        """
+        package = package if isinstance(package, dict) else self.ai_package
+        strategy = str(package.get("script_block_strategy") or "").strip()
+        if strategy == "chapter_budget_story_segment":
+            return True
+        return any(
+            isinstance(block, dict)
+            and str(block.get("script_block_strategy") or "").strip()
+            == "chapter_budget_story_segment"
+            for block in (package.get("script_blocks") or [])
+        )
